DJANGO_SECRET_KEY=<your-secret-key>
DJANGO_DEBUG=<True-or-False>
ALLOWED_HOSTS=<your-allowed-hosts>

# Database
DB_NAME=<your-db-name>
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>
DB_HOST=<your-db-host>
DB_PORT=<your-db-port> 

# Redis
CELERY_BROKER_URL=<your-celery-broker-url>

# CORS
CORS_ALLOWED_ORIGINS=<your-cors-allowed-origins>

# LLM Provider
LLM_PROVIDER=<your-llm-provider>
LLM_FALLBACK_PROVIDER=<your-llm-fallback-provider>
EMBEDDING_PROVIDER=<your-embedding-provider>

# Ollama
OLLAMA_MODEL=<your-ollama-model>
OLLAMA_EMBEDDING_MODEL=<your-ollama-embedding-model>
OLLAMA_HOST=<your-ollama-host>

# OpenAI
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=<your-openai-model>
OPENAI_EMBEDDING_MODEL=<your-openai-embedding-model>
