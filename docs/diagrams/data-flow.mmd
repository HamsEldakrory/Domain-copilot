flowchart LR

    %% =========================
    %% USER TRUST BOUNDARY
    %% =========================
    subgraph USER["USER TRUST BOUNDARY"]
        direction TB

        A["Adjuster"]
        M["Manager"]
        UI["React Web UI"]

        A --> UI
        M --> UI
    end


    %% =========================
    %% APPLICATION TRUST BOUNDARY
    %% =========================
    subgraph APP["APPLICATION TRUST BOUNDARY"]
        direction TB

        API["Django REST API"]

        AUTH["Authentication / Authorization"]

        AO["Agent Orchestrator"]

        RET["Retrieval Service"]

        subgraph DATA[" "]
            direction LR
            DB[("PostgreSQL")]
            VECTOR[("pgvector")]
        end

        API --> AUTH
        AUTH --> AO
        AO --> RET

        RET -->|"Claim / policy queries"| DB
        RET -->|"Semantic search"| VECTOR

        DB -->|"Selected claim data"| RET
        VECTOR -->|"Selected policy chunks"| RET
    end


    %% =========================
    %% EXTERNAL TRUST BOUNDARY
    %% =========================
    subgraph EXT["EXTERNAL TRUST BOUNDARY"]
        direction TB

        LLM["LLM Provider"]
    end


    %% =========================
    %% MAIN SYSTEM FLOW
    %% =========================

    UI -->|"HTTPS"| API

    RET --> AO

    AO -->|"Question + selected context"| LLM
    LLM -->|"Generated tokens"| AO

    AO -->|"Streaming response + progress events"| API


    %% =========================
    %% NOTE
    %% =========================

    NOTE["LLM does not directly access PostgreSQL or pgvector.<br/>The application selects the context sent to the LLM."]

    AO -.-> NOTE


    %% =========================
    %% STYLING
    %% =========================

    style USER fill:#e8f4fd,stroke:#1168bd,stroke-width:2px
    style APP fill:#f3f4f6,stroke:#374151,stroke-width:2px
    style EXT fill:#fff4e5,stroke:#d97706,stroke-width:2px

    style DATA fill:none,stroke:none

    style NOTE fill:#fffde7,stroke:#999,stroke-width:1px,stroke-dasharray:5 5